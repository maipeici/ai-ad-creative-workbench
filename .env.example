# AI Ad Creative Workbench
# Copy this file to .env and fill in your own local configuration.
# .env stays on your computer and must not be committed.
# Values below are examples; no real credentials are included.

PORT=8787

# Google Vertex AI: copy these fields from your service account.
# Put private_key inside double quotes, preserving its \n line breaks.
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_TOKEN_URI=https://oauth2.googleapis.com/token
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-pro
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_VEO_MODEL=veo-3.0-fast-generate-001

# OpenAI-compatible providers, used when Vertex is not configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=180000

IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1536

# Blank selects automatically. Options: vertex | http | mock | manual.
VIDEO_MODE=
VIDEO_MODEL=
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_STATUS_URL=
VIDEO_GENERATE_AUDIO=true

TTS_ENABLED=true
TTS_VOICE=relatable-female
TTS_AMBIENT_VOLUME=0.3
TTS_VO_VOLUME=1.1

# Local video composition and subtitle settings.
FFMPEG_PATH=ffmpeg
SUBTITLE_FONT=