{
  "notice": "依据《中华人民共和国广告法》及主流信息流平台审核规则整理的基线词库。平台规则持续更新，正式投放前仍需以平台审核结果为准；本词库用于前置自查，降低被拒率。",
  "updatedAt": "2026-09-21",

  "rules": [
    {
      "id": "superlative",
      "name": "极限词 / 绝对化用语",
      "severity": "block",
      "basis": "广告法第九条：不得使用国家级、最高级、最佳等用语",
      "terms": [
        "最便宜", "最低价", "最省", "最划算", "最优惠", "最好", "最佳", "最强", "最快", "最高",
        "第一", "全国第一", "行业第一", "排名第一", "销量第一",
        "国家级", "世界级", "顶级", "极致", "唯一", "独一无二",
        "绝对", "百分百", "100%", "全网最低", "史上最低", "无人能及", "首选", "领导品牌"
      ]
    },
    {
      "id": "guarantee",
      "name": "虚假承诺 / 保证性表述",
      "severity": "block",
      "basis": "不得承诺无法保证的结果或收益",
      "terms": [
        "保证", "包赚", "稳赚", "零风险", "无风险", "永久免费", "终身免费", "一定能", "必定",
        "绝对安全", "百分百安全", "万无一失", "从不涨价", "永不涨价"
      ]
    },
    {
      "id": "competitor",
      "name": "贬低竞品 / 不当比较",
      "severity": "block",
      "basis": "不得贬低其他经营者的商品或服务",
      "terms": [
        "比滴滴便宜", "碾压", "秒杀同行", "吊打", "垃圾平台", "黑心平台",
        "其他平台都贵", "甩开对手", "遥遥领先同行"
      ]
    },
    {
      "id": "urgency-fake",
      "name": "虚假紧迫 / 诱导性表述",
      "severity": "warn",
      "basis": "限时限量表述须有真实依据",
      "terms": [
        "仅此一次", "最后一天", "仅剩几个名额", "错过再无", "立刻抢光",
        "手慢无", "疯抢", "免费送", "白送", "0元购"
      ]
    },
    {
      "id": "money-claim",
      "name": "收益与金额夸大",
      "severity": "warn",
      "basis": "涉及金额须与已确认事实一致",
      "terms": ["月入过万", "轻松赚", "暴赚", "白菜价", "不要钱", "血赚"]
    },
    {
      "id": "safety-absolute",
      "name": "出行安全绝对化",
      "severity": "block",
      "basis": "出行服务不得对安全作绝对化承诺",
      "terms": ["绝对安全", "零事故", "百分百准时", "从不迟到", "保证准点", "必到"]
    },
    {
      "id": "medical-social",
      "name": "医疗 / 社会敏感",
      "severity": "block",
      "basis": "平台通用审核红线",
      "terms": ["治愈", "疗效", "包治", "扶贫", "低保", "失业补贴", "政府补贴", "国家补贴"]
    },
    {
      "id": "vulgar",
      "name": "低俗 / 不适宜表达",
      "severity": "block",
      "basis": "平台内容生态规则",
      "terms": ["约炮", "裸", "赌", "博彩", "一夜暴富", "小姐姐上车", "香艳"]
    }
  ],

  "requireFactBinding": {
    "note": "命中以下模式的文案必须绑定 factId，否则视为无依据表述",
    "patterns": [
      "\\d+\\s*元",
      "\\d+\\s*折",
      "\\d+\\s*块",
      "\\d+\\s*%",
      "立减",
      "补贴",
      "优惠券",
      "领券",
      "抵扣",
      "红包",
      "新人",
      "首单",
      "免单",
      "最高可省",
      "省一笔",
      "省钱",
      "限时",
      "有效期",
      "满\\s*\\d+"
    ],
    "campaignOnlyNote": "以下模式属于活动权益类表述，必须绑定 type=campaign 且 status=confirmed 的事实；仅绑定产品功能类事实不足以支撑",
    "campaignOnlyPatterns": [
      "\\d+\\s*元",
      "\\d+\\s*折",
      "\\d+\\s*块",
      "立减",
      "补贴",
      "优惠券",
      "领券",
      "抵扣",
      "红包",
      "新人券",
      "免单",
      "最高可省",
      "省一笔",
      "满\\s*\\d+"
    ]
  },

  "overlayRequired": {
    "note": "以下类型的信息必须使用后期叠加或已确认素材呈现，禁止交给视频模型绘制",
    "categories": [
      "优惠金额与券面额",
      "使用门槛与适用条件",
      "活动名称与有效期",
      "App 界面与下单路径",
      "品牌 Logo",
      "价格与预估费用",
      "CTA 按钮与文案"
    ]
  }
}
